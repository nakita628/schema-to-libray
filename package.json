{
  "name": "schema-to-library-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "vp fmt --check && vp run -r check && vp run lint",
    "coverage": "vp run schema-to-library#coverage",
    "deps": "mkdir -p /tmp/pnpm-store && pnpm config set store-dir /tmp/pnpm-store && rm -rf node_modules && rm -rf pnpm-lock.yaml && rm -rf ~/.pnpm-store && pnpm store prune && pnpm install --no-prefer-frozen-lockfile",
    "fix": "vp fmt && vp run -r check --fix && markdownlint-cli2 --fix && textlint --fix \"**/*.md\" \"**/*.mdc\"",
    "lint": "markdownlint-cli2 && textlint \"**/*.md\" \"**/*.mdc\" && cspell --no-progress --dot \"**/*.{md,mdc,ts,js,mjs,json,jsonc,yaml,yml}\" && secretlint --secretlintignore .secretlintignore --maskSecrets \"**/*\" && textlint --config .textlintrc.links.json \"**/*.md\" \"**/*.mdc\"",
    "test": "vp test && vp run schema-to-library#test"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "cspell": "^10.2.1",
    "markdownlint-cli2": "^0.23.2",
    "secretlint": "^13.0.5",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-no-dead-link": "^6.2.3",
    "textlint-rule-terminology": "^5.2.16",
    "vite-plus": "^0.3.0"
  },
  "packageManager": "pnpm@11.24.0"
}
